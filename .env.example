# ------------------------------------------------------------------
# Frontend (public — safe to expose; security is enforced by RLS)
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# Optional: brand logo URL (defaults to the Ikris website logo)
VITE_BRAND_LOGO_URL=https://ikrispharmanetwork.com/assets/img/logo.png

# ------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set` or the dashboard.
# NEVER put these in the frontend or commit real values.
# ------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   (recommended)
# GOOGLE_SHEETS_API_KEY=<only if the sheet is link-shared>
# SYNC_CRON_SECRET=<long random string, for scheduled sync>
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# APP_URL=https://your-app.vercel.app
